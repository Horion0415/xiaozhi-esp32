{
    "target": "esp32c5",
    "builds": [
        {
            "name": "esp-sensairhalo",
            "sdkconfig_append": [
                "CONFIG_IDF_TARGET=\"esp32c5\"",
                "CONFIG_BOARD_TYPE_ESP_SENSAIRHALO=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6",
                "CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n",
                "CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n",
                "CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0",
                "CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n",
                "CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=768",
                "CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048",
                "CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y",
                "CONFIG_MBEDTLS_HARDWARE_AES=n",
                "CONFIG_MBEDTLS_HARDWARE_SHA=n",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=3072",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
                "CONFIG_LWIP_IPV6=n",
                "CONFIG_USE_ESP_WAKE_WORD=y",
                "CONFIG_SR_WN_WN9S_HIESP=n",
                "CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y",
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                "CONFIG_BSP_AUDIO_SAMPLE_RATE=16000",
                "CONFIG_BSP_ADC_MIC_CHANNEL=3",
                "CONFIG_BSP_LCD_SPI=n",
                "CONFIG_BSP_LCD_PARLIO=y",
                "CONFIG_CAMERA_BF3901=y",
                "CONFIG_CAMERA_BF3901_AUTO_DETECT_SPI_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_BF3901_SPI_RGB565_240X320_15FPS=y",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_240X320_12FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_120X160_10FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_240X240_10FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_240X320_15FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_YUYV_120X160_5FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_YUYV_240X320_12FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_YUYV_120X160_10FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_YUYV_240X240_10FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_YUV422_YUYV_240X320_15FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_RGB565_240X320_15FPS=y",
                "CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_YUV422_240X320_15FPS=n",
                "CONFIG_CAMERA_BF3901_SPI_IF_FORMAT_INDEX_DEFAULT=0",
                "CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=y"
            ]
        }
    ]
}
